<?xml version="1.0" encoding="utf-8"?>
<!-- Every FitPal widget: one drawn card (w_canvas), an optional row of buttons under the main area,
     and an optional live countdown the launcher ticks by itself. WidgetRender sets the padding,
     what's visible and the taps. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Chronometer
                android:id="@+id/w_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/w_timer_shadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:shadowColor="#99000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/w_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/w_act0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/w_act1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/w_act2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/w_act3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
