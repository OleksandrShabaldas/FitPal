<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scaled down a touch so the apple has more breathing room inside the icon. -->
    <group
        android:pivotX="54"
        android:pivotY="55"
        android:scaleX="0.82"
        android:scaleY="0.82">

        <!-- The calorie ring is the apple's outline — but left OPEN at the top, with two
             rounded loose ends, like a progress ring that hasn't closed (the day's calories
             aren't all in yet). Warm gold gradient. -->
        <path
            android:pathData="M46,44
                C43,40 41,37 37,38
                C31,41 29,49 30,57
                C31,67 37,80 45,81
                C49,81.5 51,78.5 54,78.5
                C57,78.5 59,81.5 63,81
                C71,80 77,67 78,57
                C79,49 77,41 71,38
                C67,37 65,40 62,44"
            android:fillColor="#00000000"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="30"
                    android:startY="40"
                    android:endX="78"
                    android:endY="80"
                    android:startColor="#E8A93C"
                    android:endColor="#F7DDA6" />
            </aapt:attr>
        </path>

        <!-- Stem floating in the gap, just above the apple's open top -->
        <path
            android:pathData="M54,39 C54,35 54.5,32 56,28"
            android:fillColor="#00000000"
            android:strokeColor="#F3CE7C"
            android:strokeWidth="3.5"
            android:strokeLineCap="round" />

        <!-- A small leaf off the stem so the shape reads clearly as an apple -->
        <path
            android:pathData="M56,31 C59,26 65,25 68,27 C67,31 61,33 56,31 Z"
            android:fillColor="#F3CE7C" />
    </group>
</vector>
