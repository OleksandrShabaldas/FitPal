<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview card (warm): the app's backdrop colours, a glow top-right, a hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF3A261A"
                android:centerColor="#FF241814"
                android:endColor="#FF0E0B0A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:type="radial"
                android:centerX="0.85"
                android:centerY="0.05"
                android:gradientRadius="140dp"
                android:startColor="#66F3C46E"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
