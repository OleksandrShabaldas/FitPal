<?xml version="1.0" encoding="utf-8"?>
<!-- Weight: the latest weigh-in and its trend. Drawn by WidgetUpdater; the look is picked in WidgetConfigActivity when it's added
     (and again from the widget's long-press menu). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.fitpal.app.widget.WidgetConfigActivity"
    android:description="@string/widget_weight_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_preview_weight"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
