<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Internet: one-time AI model download, online food databases (Open Food Facts),
         and the optional online AI model (Gemini). The app still works fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Check connectivity so the AI router skips the online model when there's no internet -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Read steps from Health Connect (which Samsung Health feeds) — on-device only -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Keep meal analysis running in the background + show its progress notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm the optional daily reminder after a device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Fire scheduled AI overviews / reminders on time even in Doze (user-grantable on Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Optional: let the user exempt FitPal from battery optimisation so background overviews run -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Self-update: FitPal is sideloaded (no Play Store), so it offers new GitHub releases and
         hands the APK to the system installer. Android still asks the user to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- So we can detect / open the Health Connect app, and reach Calistapp's wake-up receiver -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.calistapp" />
    </queries>

    <application
        android:name=".FitPalApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitPal">

        <!-- The app's one activity. Its launcher icon comes from the activity-alias below that's
             enabled (Settings → Appearance → App icon); ".MainActivity" is the original one. -->
        <activity
            android:name=".FitPalActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:theme="@style/Theme.FitPal">
            <!-- Share a food photo from any gallery/camera app straight into analysis -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Health Connect permissions rationale (Android 13 and below) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

